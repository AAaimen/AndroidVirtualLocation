<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- 标题栏 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛰 虚拟定位工具"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="修改手机GPS定位位置"
            android:textSize="14sp"
            android:textColor="#757575"
            android:gravity="center"
            android:paddingBottom="24dp" />

        <!-- 状态卡片 -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/card_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/status_indicator"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/circle_red" />

                <TextView
                    android:id="@+id/tv_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="虚拟定位已关闭"
                    android:textSize="16sp"
                    android:textColor="#333333"
                    android:paddingStart="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 坐标输入卡片 -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📍 目标坐标"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:paddingBottom="16dp" />

                <!-- 纬度 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="纬度 (Latitude)"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/et_latitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal|numberSigned"
                    android:hint="-90 ~ 90"
                    android:textSize="16sp"
                    android:background="@drawable/input_background"
                    android:padding="12dp"
                    android:layout_marginBottom="14dp" />

                <!-- 经度 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="经度 (Longitude)"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/et_longitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal|numberSigned"
                    android:hint="-180 ~ 180"
                    android:textSize="16sp"
                    android:background="@drawable/input_background"
                    android:padding="12dp"
                    android:layout_marginBottom="14dp" />

                <!-- 海拔 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="海拔 (Altitude, 米)"
                    android:textSize="13sp"
                    android:textColor="#666666"
                    android:paddingBottom="6dp" />

                <EditText
                    android:id="@+id/et_altitude"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:hint="0 ~ 9000"
                    android:textSize="16sp"
                    android:background="@drawable/input_background"
                    android:padding="12dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 快捷城市选择 -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🏙 快速选择城市"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:paddingBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_beijing"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="北京"
                        android:textSize="13sp"
                        android:backgroundTint="#E3F2FD"
                        android:textColor="#1976D2" />

                    <Button
                        android:id="@+id/btn_shanghai"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="上海"
                        android:textSize="13sp"
                        android:backgroundTint="#E3F2FD"
                        android:textColor="#1976D2" />

                    <Button
                        android:id="@+id/btn_guangzhou"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:text="广州"
                        android:textSize="13sp"
                        android:backgroundTint="#E3F2FD"
                        android:textColor="#1976D2" />

                    <Button
                        android:id="@+id/btn_shenzhen"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:text="深圳"
                        android:textSize="13sp"
                        android:backgroundTint="#E3F2FD"
                        android:textColor="#1976D2" />
                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 操作按钮 -->
        <Button
            android:id="@+id/btn_start_mock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶  开启虚拟定位"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btn_stop_mock"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="⬛  停止虚拟定位"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#F44336"
            android:layout_marginBottom="20dp" />

        <!-- 提示说明 -->
        <androidx.cardview.widget.CardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:backgroundTint="#FFF8E1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠ 使用说明"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#F57F17"
                    android:paddingBottom="8dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1. 请先在手机「开发者选项」中设置本应用为「模拟位置信息应用」\n2. 首次使用需授予位置权限\n3. 部分应用可能无法被欺骗（如微信等）\n4. 本工具仅供开发测试使用"
                    android:textSize="13sp"
                    android:textColor="#795548"
                    android:lineSpacingMultiplier="1.5" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>
